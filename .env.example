# Groq Whisper STT
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo

# OpenAI-compatible LLM
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# Silero TTS
SILERO_TTS_SPEAKER=xenia
# Optional ASCII cache path. By default: %LOCALAPPDATA%\VoiceBridge\silero_models
# Optional: cpu or gpu. The UI can also save this choice.
TTS_DEVICE=cpu

# Optional RVC post-processing. Configure the command in the UI or here.
# Placeholders: {input_wav}, {output_wav}, {model_path}, {index_path}
RVC_ENABLED=false
# RVC_CMD_TEMPLATE=python infer_cli.py --input_path "{input_wav}" --opt_path "{output_wav}" --model_name "{model_path}" --index_path "{index_path}"
