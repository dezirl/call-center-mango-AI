{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Bridge",
  "version": "0.3.0",
  "identifier": "local.voicebridge.desktop",
  "build": {
    "frontendDist": "../static",
    "devUrl": "http://127.0.0.1:8000"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Voice Bridge",
        "width": 1420,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "resources": ["backend/voicebridge-backend"]
  }
}
